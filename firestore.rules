rules_version = '2';
// Reglas de la base de datos de New Digital Marketing.edu.
// Solo la plataforma (con acceso Anónimo activado en Authentication) puede leer y escribir.
// Pégalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
